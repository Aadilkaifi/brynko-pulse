# Secrets for your alert channels: passwords, bot tokens, webhook URLs.
#
# Write one per line as NAME=value, then refer to it in channels.yaml as ${NAME}.
# For example, this line:
#   PULSE_SMTP_PASSWORD=my-app-password
# is used in channels.yaml as:
#   password: ${PULSE_SMTP_PASSWORD}
#
# Keep this file private. pulse refuses to start if other users can read it.
# A variable with the same name set in the environment takes precedence.
#
# Remove the # in front of the lines you need and fill in the values:
# PULSE_SMTP_PASSWORD=
# PULSE_TELEGRAM_TOKEN=
# PULSE_SLACK_WEBHOOK=
# PULSE_WEBHOOK_SECRET=
# PULSE_WHATSAPP_TOKEN=
# PULSE_BRYNKO_KEY=
